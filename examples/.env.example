# Copy to a file named .env beside the docker-compose.yml you use, and fill it in.
# Docker Compose reads it on its own. Never commit the real one.

# The admin sign-in password. Required.
ADMIN_PASSWORD=

# The caddy/, traefik/ and nginx/ examples only: the public name of your Postern.
POSTERN_HOST=postern.example.com

# The traefik/ example only: where Let's Encrypt sends expiry notices.
ACME_EMAIL=you@example.com
